# ─────────────────────────────────────────────────────────────────────────
# Supabase — find these in your project's Settings → API
# ─────────────────────────────────────────────────────────────────────────
# Project URL + anon (public) key. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (SECRET — server only). Used by /api/account/delete and
# /api/push to bypass RLS. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────
# GIPHY — for the in-app GIF picker (/api/gifs). Get a key at developers.giphy.com
# ─────────────────────────────────────────────────────────────────────────
GIPHY_API_KEY=your-giphy-api-key

# ─────────────────────────────────────────────────────────────────────────
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────
# Public key is exposed to the browser to subscribe the device.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Private key is SECRET — server only.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Shared secret guarding the /api/push webhook (must match the Supabase
# pg_net trigger's x-push-secret header).
PUSH_WEBHOOK_SECRET=a-long-random-string
# Contact email embedded in VAPID details (push providers require it).
PUSH_CONTACT_EMAIL=mailto:support@hypefy.chat

# ─────────────────────────────────────────────────────────────────────────
# OneShot (view-once DM photos) — shared secret guarding the
# /api/oneshot/reap webhook, called by Supabase pg_net on a cron schedule.
# Must match the value stored in Supabase Vault under 'oneshot_reap_secret'
# (see docs/BACKEND.md) — set up once, outside of version control.
# ─────────────────────────────────────────────────────────────────────────
ONESHOT_REAP_SECRET=a-long-random-string

# ─────────────────────────────────────────────────────────────────────────
# Sentry (optional) — error monitoring. Leave unset to disable (SDK no-ops).
# Get the DSN from your Sentry project settings.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────
# Playwright E2E — use a THROWAWAY account, never a real one. Required by
# tests/e2e (they sign in through the real /signin UI). There is no fallback:
# the suite throws if these are unset.
# ─────────────────────────────────────────────────────────────────────────
E2E_EMAIL=
E2E_PASSWORD=

# Spotify Web API (music search). Client Credentials flow — server only.
# Create an app at developer.spotify.com/dashboard to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: exact redirect URI registered in the Spotify dashboard.
# Needed because Spotify rejects "localhost" (use 127.0.0.1 locally) and
# Vercel preview hostnames change per deployment.
SPOTIFY_REDIRECT_URI=

# Firebase Cloud Messaging — native push (Android/iOS app only).
# The service account JSON from Firebase console > Project settings >
# Service accounts, pasted as ONE line. Web push keeps using VAPID above.
FCM_SERVICE_ACCOUNT=

# Pre-launch invite gate on app.hypefy.chat. Unset = gate disabled (every
# request passes straight through), which is what you want locally.
# Set both in Vercel Production to switch the wall on.
APP_INVITE_CODE      = echo-pulse-335
# HMAC key for the gate cookie. Rotating either value invalidates every
# cookie already issued.
INVITE_COOKIE_SECRET=
