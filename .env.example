# ─────────────────────────────────────────────────────────────────────────
# Supabase — find these in your project's Settings → API
# ─────────────────────────────────────────────────────────────────────────
# Project URL + anon (public) key. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (SECRET — server only). Used by /api/account/delete and
# /api/push to bypass RLS. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────
# GIPHY — for the in-app GIF picker (/api/gifs). Get a key at developers.giphy.com
# ─────────────────────────────────────────────────────────────────────────
GIPHY_API_KEY=your-giphy-api-key

# ─────────────────────────────────────────────────────────────────────────
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────
# Public key is exposed to the browser to subscribe the device.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Private key is SECRET — server only.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Shared secret guarding the /api/push webhook (must match the Supabase
# pg_net trigger's x-push-secret header).
PUSH_WEBHOOK_SECRET=a-long-random-string
# Contact email embedded in VAPID details (push providers require it).
PUSH_CONTACT_EMAIL=mailto:support@hypefy.chat

# ─────────────────────────────────────────────────────────────────────────
# OneShot (view-once DM photos) — shared secret guarding the
# /api/oneshot/reap webhook, called by Supabase pg_net on a cron schedule.
# Must match the value stored in Supabase Vault under 'oneshot_reap_secret'
# (see docs/BACKEND.md) — set up once, outside of version control.
# ─────────────────────────────────────────────────────────────────────────
ONESHOT_REAP_SECRET=a-long-random-string

# ─────────────────────────────────────────────────────────────────────────
# Sentry (optional) — error monitoring. Leave unset to disable (SDK no-ops).
# Get the DSN from your Sentry project settings.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────
# Playwright E2E — use a THROWAWAY account, never a real one. Required by
# tests/e2e (they sign in through the real /signin UI). There is no fallback:
# the suite throws if these are unset.
# ─────────────────────────────────────────────────────────────────────────
E2E_EMAIL=
E2E_PASSWORD=

# Spotify Web API (music search). Client Credentials flow — server only.
# Create an app at developer.spotify.com/dashboard to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: exact redirect URI registered in the Spotify dashboard.
# Needed because Spotify rejects "localhost" (use 127.0.0.1 locally) and
# Vercel preview hostnames change per deployment.
SPOTIFY_REDIRECT_URI=

# Firebase Cloud Messaging — native push (Android/iOS app only).
# The service account JSON from Firebase console > Project settings >
# Service accounts, pasted as ONE line. Web push keeps using VAPID above.
FCM_SERVICE_ACCOUNT=

# Pre-launch invite gate on app.hypefy.chat. Unset = gate disabled (every
# request passes straight through), which is what you want locally.
# Set both in Vercel Production to switch the wall on.
#
# Use a NEW value. The code this gate previously shipped with is readable in
# this repo's git history (commit 7340b67), so it protects nothing.
APP_INVITE_CODE=
# HMAC key for the gate cookie. Rotating either value invalidates every
# cookie already issued.
INVITE_COOKIE_SECRET=

# Ads in the feed. Unset = no ad slot is placed at all, which is the correct
# value locally, in CI and in every preview deployment.
#
#   house    Hypefy's own Sponsored card. No third-party script, no iframe,
#            no request to anyone but Supabase. This is the mode to develop
#            and test against.
#   adsense  the real AdSense in-feed tag, and only if all three ids below
#            are set — a half-configured "adsense" falls back to off.
#
# NEVER set this to `adsense` outside Production without NEXT_PUBLIC_ADS_TEST
# below. The Playwright suite signs in through the real UI, so a preview deploy
# carrying a live tag generates ad impressions from a datacenter IP. That is
# invalid traffic, and it is the fastest way to lose an AdSense account.
#
# Note that "adsense" is still not what every reader gets: the native Android
# WebView and any EEA/UK reader fall back to the house card. See src/lib/ads.ts.
NEXT_PUBLIC_ADS_MODE=
# Publisher id, e.g. ca-pub-0000000000000000.
NEXT_PUBLIC_ADSENSE_CLIENT=
# The in-feed ad unit's slot id, from AdSense > Ads > By ad unit.
NEXT_PUBLIC_ADSENSE_FEED_SLOT=
# OPTIONAL. The layout key AdSense generates alongside an In-feed unit
# ("-fb+5w+4e-db+86"). Set it and the slot renders as In-feed; leave it empty
# and the same slot renders as a Display unit inside the same card.
#
# Empty is a perfectly good answer. AdSense's In-feed builder wants to scan a
# live feed to copy its style and reports "couldn't find any feed page" when
# the feed is behind a login — which ours is. The card supplies the chrome,
# the label, the height and the fallback either way.
NEXT_PUBLIC_ADSENSE_FEED_LAYOUT_KEY=
# OPTIONAL. A separate Display unit for the Shots reel. The In-feed unit is
# shaped for a card between posts, so on a full-screen reel it renders at card
# height in a tall black page; a responsive Display unit fills the box. Unset,
# Shots reuses the feed unit, which works.
NEXT_PUBLIC_ADSENSE_SHOTS_SLOT=

# Ask Google for test creatives instead of real ones (data-adtest="on").
# The script loads, the unit is requested and filled, and the whole path runs
# exactly as it will in production — but the impression is not counted and not
# paid, so it cannot generate invalid traffic. Set this to 1 whenever
# NEXT_PUBLIC_ADS_MODE=adsense anywhere but Production.
#
# It still needs a real, approved publisher id above: there is no way to
# exercise the served path without one.
NEXT_PUBLIC_ADS_TEST=

# Google Analytics 4 measurement id. Optional: Hypefy's own id is built into
# src/lib/analytics.ts and this only overrides it. Nothing is sent from
# anywhere but the live domains either way.
#
# Real ads and real analytics both refuse to run off the live hostnames —
# see MEASURED_HOSTS in src/lib/analytics.ts. A developer reloading /home
# forty times is not forty sessions, and once that is in the reports it
# cannot be taken out.
NEXT_PUBLIC_GA_ID=
# Send from localhost anyway, tagged so it lands in GA DebugView instead of
# the reports. For verifying an installation, not for day-to-day dev.
NEXT_PUBLIC_GA_DEBUG=
