# @vercel/analytics declares optional peer deps for every framework it
# supports, including a Svelte plugin that wants vite 8 — while vitest pins
# vite 5. The conflict is between two packages we never use together, so npm's
# strict peer resolution blocks an install that is actually fine.
#
# Set here rather than passed on the command line so local installs and CI
# (npm ci) resolve identically; a flag someone has to remember is a lockfile
# that drifts.
legacy-peer-deps=true
