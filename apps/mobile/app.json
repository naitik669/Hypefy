{
  "expo": {
    "name": "Hypefy",
    "slug": "hypefy",
    "scheme": "chat.hypefy",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "chat.hypefy.app",
      "allowBackup": false,
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "chat.hypefy.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Hypefy uses the camera to record Shots and take photos for posts.",
          "microphonePermission": "Hypefy uses the microphone to record sound with your Shots.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "63031c8b-ca59-4aca-b7d3-1f4ecd9e00a6"
      }
    },
    "owner": "hypefy-platform",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/63031c8b-ca59-4aca-b7d3-1f4ecd9e00a6"
    }
  }
}
