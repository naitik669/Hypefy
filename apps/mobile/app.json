{
  "expo": {
    "name": "Hypefy",
    "slug": "hypefy",
    "scheme": "chat.hypefy",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "chat.hypefy.app",
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mark.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "chat.hypefy.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Hypefy uses the camera to take photos for your posts.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "63031c8b-ca59-4aca-b7d3-1f4ecd9e00a6"
      }
    },
    "owner": "hypefy-platform",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/63031c8b-ca59-4aca-b7d3-1f4ecd9e00a6"
    }
  }
}
